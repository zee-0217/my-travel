# Copy to .env only when .env does not exist. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# OpenAI Responses API (server only)
OPENAI_API_KEY=
# Set an available model that supports Responses API and Structured Outputs.
OPENAI_MODEL=

# Agent limits (server only, optional)
AGENT_MAX_ITERATIONS=8
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_MS=240000

# NAVER API HUB: Search > Local (separate from NAVER Maps)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# NAVER Cloud Platform: NEW Maps application credentials
# Client ID is public for Web Dynamic Map; Client Secret always stays on the server.
# Enable Web Dynamic Map and register http://localhost:3000 (or the URL you use) in NCP.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# KMA official short-term forecast: set ONE key; all requests are server-side.
# API HUB authKey (preferred) or data.go.kr decoded serviceKey.
KMA_API_KEY=
KMA_SERVICE_KEY=

# Free Korea Tourism Organization public data, separate service approval required.
# data.go.kr -> Korean Tourism Information Service (KorService2), decoded service key.
TOUR_API_KEY=

# Open-Meteo free non-commercial weather fallback; false disables it
WEATHER_FREE_FALLBACK=true

# Vercel server-side ephemeral sessions (30-minute TTL); not browser trip storage.
# Required on Vercel for chat edits and selected-place addition across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Different namespace for each project/environment. Default uses VERCEL_ENV.
SESSION_NAMESPACE=

# Global app request caps in production; these do not replace provider billing limits.
AI_REQUESTS_PER_HOUR=30
API_REQUESTS_PER_MINUTE=120
